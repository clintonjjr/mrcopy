# ── This agent is SIGNAL-ONLY. No Binance trading keys here. ──────────────
# Your execution agent (connected via Binance Agent OS MCP) holds the keys
# in a dedicated sub-account and places the actual Spot / USDⓈ-M orders.

# Wallet pool: .env seeds are just the opening rumor. Discovery fills the
# pool from the Hyperliquid leaderboard automatically and rotates the dead.
# (Optional seeds — leave as-is and the desk still fills itself.)
TRACKED_WALLETS=0x0000000000000000000000000000000000000000

# Discovery: top-N by month PnL, min equity, hourly re-sync, pool cap.
DISCOVERY_EVERY_MIN=60
DISCOVERY_TOP=40
DISCOVERY_MIN_EQUITY=10000
POOL_MAX=60

# Polling
HL_POLL_MS=15000
HL_INFO_URL=https://api.hyperliquid.xyz

# Aster public market data (Binance-fork fapi, no key needed for market data)
ASTER_FAPI_URL=https://fapi.asterdex.com
# Optional: AsterScan / indexer webhook secret for trader pushes
INGEST_SECRET=change-me

# Binance public market data (no key needed — listing/funding/lag checks only)
BINANCE_FAPI_URL=https://fapi.binance.com

# Signal engine
MIN_WALLETS_FOR_SIGNAL=2
SIGNAL_WINDOW_SECONDS=600
MIN_CONVICTION=60
ALLOW_PRE_BINANCE_ALPHA=true

# Call lifecycle
CALL_TTL_HOURS=24
EXIT_ON_LEADERS_CLOSED=2

# Where to push calls for your Binance OS execution agent (optional).
# Point this at your execution agent's webhook, or leave empty to poll GET /calls/active.
EXECUTION_WEBHOOK_URL=
EXECUTION_WEBHOOK_SECRET=

# Local REST for your execution agent to poll
PORT=8787

# Telegram alerts (human-readable CALL / EXIT pings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Learning DB
DB_PATH=./data/calls.db
DRY_RUN=true

# ── Brain (LLM strategist; leave PROVIDER=none for rule-based answers) ──
LLM_PROVIDER=none
# LLM_PROVIDER=anthropic
# LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=   # optional override (default: provider's cloud endpoint)
BRIEFING_TTL_HOURS=6

# ── Risk ──
RISK_COOLDOWN_MIN=60
RISK_MAX_STOPS=3
RISK_HALT_MIN=240
RISK_MAX_DAY_DD_PCT=6

# ── Access — SET THIS on AWS. /ask, /briefing, /plans, /close, /mcp ──
# require it; /calls/active, /stats, /health stay open for the UI.
API_SECRET=change-me-on-aws
